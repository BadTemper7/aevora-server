# AEVORA application (do not commit real .env)
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace_with_a_secure_random_32_plus_character_secret
MONGODB_URI=mongodb://127.0.0.1:27017/aevora
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImageKit is the PRIMARY storage provider. No Cloudflare account is needed.
# Get credentials from ImageKit dashboard -> Developer Options -> API Keys.
# Never put IMAGEKIT_PRIVATE_KEY in client/.env or commit server/.env.
STORAGE_PROVIDER=imagekit
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_FOLDER_PREFIX=/aevora

# OPTIONAL legacy Cloudflare R2 settings, only if some OLD media records already use it.
# If no media was ever uploaded to R2, leave all legacy settings unset.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=

# Optimization and safe quota defaults
MEDIA_ROOT=./storage
MAX_CONCURRENT_UPLOADS=4
MIN_TEMP_FREE_MB=512
MAX_IMAGE_MB=12
MAX_VIDEO_MB=150
MAX_DOCUMENT_MB=12
MAX_USER_STORAGE_MB=2048
MAX_MEDIA_DURATION_SEC=600
IMAGE_MAX_WIDTH_AVATAR=512
IMAGE_MAX_WIDTH_COVER=1920
IMAGE_MAX_WIDTH_POST=1920
IMAGE_MAX_WIDTH_MESSAGE=1600
IMAGE_MAX_WIDTH_COMMUNITY=1920
IMAGE_WEBP_QUALITY=78
VIDEO_MAX_HEIGHT=1080
VIDEO_PRESET=medium
VIDEO_CRF=27
VIDEO_WORKER_CONCURRENCY=2
VIDEO_PROCESS_TIMEOUT_SEC=900
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Production defaults to required. Install/configure clamdscan with a running ClamAV daemon.
MALWARE_SCAN_MODE=disabled
CLAMAV_COMMAND=clamdscan

# Cleanup examines only known, failed provider uploads. OFF until dry-run review.
IMAGEKIT_CLEANUP_ENABLED=false
IMAGEKIT_CLEANUP_BATCH=100
IMAGEKIT_CLEANUP_MIN_AGE_HOURS=72

# Existing optional services
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TENOR_API_KEY=

# Stories: maximum length of an uploaded original/licensed audio track
MAX_STORY_TRACK_DURATION_SEC=600
